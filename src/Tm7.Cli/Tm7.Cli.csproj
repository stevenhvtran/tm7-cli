<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tm7</AssemblyName>
    <RootNamespace>Tm7.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT/trim warnings for DataContractSerializer are suppressed at the call site
         in Tm7XmlSerializer.cs via UnconditionalSuppressMessage attributes.
         Types are preserved via DynamicDependency attributes and TrimmerRoots.xml. -->
    <!-- DataContractSerializer creates model objects without calling constructors,
         so non-nullable properties may be uninitialized during deserialization.
         These suppressions apply to the Tm7Model serialization classes. -->
    <NoWarn>CS8618;CS8625;CS8600;CS8603</NoWarn>
    <!-- DCS itself triggers IL3050 warnings inside System.Private.DataContractSerialization
         and ilc rolls them up into IL3053. We can't fix those from outside, but we want
         them visible (not silently suppressed) so future regressions in our own code remain
         catchable; just don't fail the build on them. Our DCS call sites carry targeted
         UnconditionalSuppressMessage attributes for IL2026/IL3050. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3050;IL3053</WarningsNotAsErrors>
    <Company>gholliday</Company>
    <Product>TM7 CLI</Product>
    <Authors>gholliday</Authors>
    <Description>A CLI tool for constructing, interrogating, and modifying Microsoft Threat Modeling Tool (.tm7) files.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tm7</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hex1b" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled default template (Azure Threat Model Template KB).
         Used by `tm7 new` and `tm7 import dot` when the template option is not specified. -->
    <EmbeddedResource Include="..\..\samples\template.tm7" LogicalName="Tm7.Cli.Resources.DefaultTemplate.tm7" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tm7.Tests" />
  </ItemGroup>

</Project>
